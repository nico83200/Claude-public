# VoyageStudio — configuration Apache (hébergement mutualisé)
Options -Indexes
DirectoryIndex index.php

# Fichiers sensibles inaccessibles depuis le web
<FilesMatch "^(config\.php|config\.sample\.php|\.env|composer\.(json|lock)|.*\.(sqlite|sqlite-wal|sqlite-shm|log|md|sh|mjs))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Forcer HTTPS (décommentez quand le certificat SSL est actif)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    RewriteRule ^(app|data|tests|vendor|scripts)(/|$) - [F,L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
