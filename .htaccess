# Sécurité : pas de listing, accès interdit aux dossiers internes
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|storage|vendor)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|composer\.(json|lock))$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|.*\.md)$">
  Require all denied
</FilesMatch>
