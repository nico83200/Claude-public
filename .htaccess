# Sécurité : pas de listing, accès interdit aux dossiers internes
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|storage|vendor|tools|dist|tests)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|composer\.(json|lock))$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|.*\.md)$">
  Require all denied
</FilesMatch>

# Service worker et manifeste jamais mis en cache : les mises à jour s'appliquent tout de suite
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
