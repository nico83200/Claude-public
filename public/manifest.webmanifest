    "categories": ["lifestyle", "productivity", "sports"],
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "screenshots": [
        { "src": "/screenshots/mobile-accueil.png", "sizes": "1080x2400", "type": "image/png", "form_factor": "narrow", "label": "Tableau de bord" },
        { "src": "/screenshots/mobile-seance.png", "sizes": "1080x2400", "type": "image/png", "form_factor": "narrow", "label": "Mode séance, même hors ligne" },
        { "src": "/screenshots/ordinateur.png", "sizes": "1600x1000", "type": "image/png", "form_factor": "wide", "label": "Fiche cheval" }
    ],
    "shortcuts": [
        { "name": "Mode écurie", "short_name": "Écurie", "url": "/hors-ligne", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
