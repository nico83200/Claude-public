# Configuration du poste d'encodage — copiez ce fichier en « encodeur.env » (jamais dans GitHub).

# Adresse de votre site : elle est écrite dans chaque puce, À VIE. Exemple : https://nfc.nlapps.fr
TAPIKARD_URL=https://nfc.nlapps.fr

# Même valeur que ENCODING_API_KEY dans les variables d'environnement Hostinger
ENCODING_API_KEY=

# Mêmes valeurs que sur Hostinger (sinon les scans seront refusés)
SUN_K_META=
SUN_MASTER_K1=

# Clé propre au poste d'encodage (pas sur Hostinger) : permet de reconfigurer les cartes.
# Générez-la une fois : openssl rand -hex 16 — et sauvegardez-la avec les deux autres.
SUN_MASTER_K0=
