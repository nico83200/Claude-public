# ---------------------------------------------------------------
# Jack&Cie — gestion équine (copier en .env puis compléter)
# Ne jamais committer de vrais identifiants.
# ---------------------------------------------------------------
APP_NAME="Jack&Cie"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Base de données MySQL / MariaDB ---------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jackcie
DB_USERNAME=jackcie
DB_PASSWORD=

# --- Sessions / cache / files ----------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
# "database" fonctionne sur un hébergement mutualisé (cron + queue:work --stop-when-empty).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Email (laisser MAIL_MAILER=log tant que le service n'est pas configuré)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe (clés depuis https://dashboard.stripe.com/apikeys) --
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Période de grâce après un paiement échoué (jours)
BILLING_GRACE_DAYS=7
# Période de récupération des données après expiration (jours, lecture seule + export)
BILLING_RECOVERY_DAYS=90

# --- Recherche d'identité des chevaux ---------------------------
# Wikidata ne nécessite aucune clé. Brave Search est facultatif.
HORSE_SEARCH_WIKIDATA=true
BRAVE_SEARCH_API_KEY=
HORSE_SEARCH_TIMEOUT=8
HORSE_SEARCH_CACHE_MINUTES=1440
HORSE_SEARCH_USER_AGENT="JackCieBot/1.0 (+https://app.example.com/contact)"

# --- Hors ligne --------------------------------------------------
# Durée de validité des données locales sans synchronisation (heures)
OFFLINE_DATA_TTL_HOURS=168
OFFLINE_MAX_HORSES=10

# --- Stockage des fichiers privés --------------------------------
UPLOAD_MAX_KB=10240

VITE_APP_NAME="${APP_NAME}"

# Proxies de confiance (ex. '*' derrière un répartiteur de charge, ou liste d'IP)
TRUSTED_PROXIES=

# --- Installation ------------------------------------------------
# Clé facultative demandée par l'installeur web (/install). Recommandé si
# l'application est en ligne avant que vous ne lanciez l'installation.
INSTALL_KEY=
# Forcer l'état « installé » (installation en ligne de commande). Laisser vide :
# l'installeur se ferme seul en créant storage/app/installed.json.
APP_INSTALLED=
