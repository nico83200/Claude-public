# URL publique du site (utilisée dans les liens de connexion et les QR codes)
APP_URL=https://tapikard.com

# Secret de signature des sessions (32+ caractères aléatoires) — OBLIGATOIRE en production
SESSION_SECRET=

# Clé fixe des formulaires (Server Actions) : sans elle, une page ouverte avant une mise à jour du site
# échoue à la validation. 32 octets en base64 : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Carte personnalisée (configurateur /creer) : masquée par défaut, la boutique ne vend que la carte Basic.
# OFFRE_PERSONNALISEE=1

# Emails des administrateurs (back-office), séparés par des virgules
ADMIN_EMAILS=admin@tapikard.com

# Base SQLite (fichier). Par défaut : ./data/tapikard.db en dev, ~/tapikard-data/tapikard.db en production.
# Doit être HORS du dossier de l'application (remplacé à chaque déploiement).
# DATABASE_PATH=/var/lib/tapikard/tapikard.db

# Données de démonstration (comptes demo/admin, cartes, scans). Par défaut : 1 en dev, 0 en production
# SEED_DEMO=0

# --- NTAG 424 DNA / SUN (voir docs/encodage-ntag424.md) — OBLIGATOIRES en production ---
# Clé commune SDMMetaRead (clé 2) et clé maître dont dérive la clé SDMFileRead (clé 1) de chaque carte
SUN_K_META=
SUN_MASTER_K1=
# Clé maître dont dérivent les clés 0, 3 et 4 de chaque carte : la même que SUN_MASTER_K0 du poste d'encodage.
# Nécessaire seulement pour encoder depuis le téléphone (application Android, page /encodage).
SUN_MASTER_K0=
# 1 = clés d'usine (00…00), non diversifiées : uniquement pour tester avec le vecteur NXP
# SUN_FACTORY_KEYS=1

# Clé d'API du poste d'encodage (POST /api/encodage)
ENCODING_API_KEY=

# --- Expédition La Poste (Colissimo, API « SLS ») : étiquettes pré-remplies et suivi automatique ---
# Contrat Colissimo (espace Colissimo Box / Entreprise) : numéro de contrat et mot de passe des services web.
# COLISSIMO_CONTRAT=
# COLISSIMO_MOT_DE_PASSE=
# Produit (DOM = Colissimo Domicile sans signature), format d'étiquette et poids du pli (kg)
# COLISSIMO_PRODUIT=DOM
# COLISSIMO_FORMAT=PDF_10x15_300dpi
# COLISSIMO_POIDS_KG=0.1
# Adresse d'expédition (aussi utilisée pour l'étiquette d'adresse quand Colissimo n'est pas configuré)
# EXPEDITEUR_NOM=Tapikard
# EXPEDITEUR_ADRESSE=12 rue de l'Atelier
# EXPEDITEUR_CP=83000
# EXPEDITEUR_VILLE=Toulon
# EXPEDITEUR_TEL=
# Signature du courrier d'accompagnement (par défaut : « L’équipe Tapikard »)
# SIGNATAIRE_NOM=Prénom Nom
# SIGNATAIRE_TITRE=Fondateur de Tapikard (par défaut : « Tapikard »)

# --- Paiement Stripe (optionnel : sans clé, paiement simulé en mode démo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails (liens de connexion, notifications) — OBLIGATOIRE en production pour pouvoir se connecter ---
# SMTP, par ex. une boîte mail Hostinger (smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Expéditeur (doit correspondre à SMTP_USER avec Hostinger)
EMAIL_FROM="Tapikard <bonjour@tapikard.com>"
