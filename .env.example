# URL publique du site (utilisée dans les liens de connexion et les QR codes)
APP_URL=https://tapikard.com

# Secret de signature des sessions (32+ caractères aléatoires) — OBLIGATOIRE en production
SESSION_SECRET=

# Emails des administrateurs (back-office), séparés par des virgules
ADMIN_EMAILS=admin@tapikard.com

# Base SQLite (fichier). Par défaut : ./data/tapikard.db en dev, ~/tapikard-data/tapikard.db en production.
# Doit être HORS du dossier de l'application (remplacé à chaque déploiement).
# DATABASE_PATH=/var/lib/tapikard/tapikard.db

# Données de démonstration (comptes demo/admin, cartes, scans). Par défaut : 1 en dev, 0 en production
# SEED_DEMO=0

# --- NTAG 424 DNA / SUN (voir docs/encodage-ntag424.md) — OBLIGATOIRES en production ---
# Clé commune SDMMetaRead (clé 2) et clé maître dont dérive la clé SDMFileRead (clé 1) de chaque carte
SUN_K_META=
SUN_MASTER_K1=
# 1 = clés d'usine (00…00), non diversifiées : uniquement pour tester avec le vecteur NXP
# SUN_FACTORY_KEYS=1

# Clé d'API du poste d'encodage (POST /api/encodage)
ENCODING_API_KEY=

# --- Paiement Stripe (optionnel : sans clé, paiement simulé en mode démo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Emails (liens de connexion, notifications) — OBLIGATOIRE en production pour pouvoir se connecter ---
# Option 1 : SMTP, par ex. une boîte mail Hostinger (smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option 2 : Resend
RESEND_API_KEY=
# Expéditeur (doit correspondre à SMTP_USER avec Hostinger)
EMAIL_FROM="Tapikard <bonjour@tapikard.com>"
